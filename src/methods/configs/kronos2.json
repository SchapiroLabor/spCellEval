{
  "method": "kronos2",
  "defaults": {
    "device": "cuda:0",
    "patch_size": 64,
    "batch_size": 16,
    "n_trials": 25,
    "c_low": 1e-10,
    "c_high": 1e5,
    "max_iter": 10000,
    "max_cells_per_type": null,
    "seed": 42,
    "folds_dir": "quantification/processed/kfolds_StratifiedGroupKFold_level3",
    "include_validation": true,
    "exclude_labels": []
  },
  "datasets": {
    "IMMUcan": {
      "exclude_markers": ["DNA1", "DNA2", "HistoneH3", "CD33", "Ecad", "cleavedPARP"],
      "marker_name_map": {
        "SMA": "A-SMA",
        "GrzB": "GZMB",
        "CD8a": "CD8",
        "TCF7": "TCF1",
        "CD303": "BDCA-2",
        "CarbonicAnhydrase": "CA9"
      }
    },
    "cHL_2_MIBI": {
      "exclude_markers": ["Histone H3", "SLP-76", "anti-H2AX (pS139)", "dsDNA", "pSLP-76", "CD153 (CD30L)"],
      "marker_name_map": {
        "B2-Microglobulin": "B2M",
        "Na-K ATPase": "NAKATP",
        "RORgT": "RORGD"
      }
    }
  }
}
