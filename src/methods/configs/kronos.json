{
  "method": "kronos",
  "defaults": {
    "device": "cuda:0",
    "patch_size": 64,
    "batch_size": 16,
    "logreg_c": 1.0,
    "leiden_resolution": 2.0,
    "leiden_n_neighbors": 15,
    "leiden_subsample": 50000,
    "folds_dir": "quantification/processed/kfolds_StratifiedGroupKFold_level3",
    "include_validation": true,
    "exclude_labels": []
  },
  "datasets": {
    "IMMUcan": {
      "exclude_markers": ["DNA1", "DNA2", "HistoneH3"],
      "marker_name_map": {
        "SMA": "A-SMA",
        "GrzB": "GZMB",
        "HLADR": "HLA_DR",
        "CD8a": "CD8",
        "cleavedPARP": "CLEAVED_CASP3",
        "TCF7": "TCF1",
        "CarbonicAnhydrase": "CA9",
        "Ecad": "E-CADHERIN",
        "CD303": "BDCA-2"
      },
      "no_equivalent": ["PDGFRb", "CD33"]
    },
    "cHL_2_MIBI": {
      "exclude_markers": ["Histone H3", "SLP-76", "anti-H2AX (pS139)", "dsDNA", "pSLP-76"],
      "marker_name_map": {
        "PD-1": "PD1",
        "Pax-5": "PAX5",
        "B2-Microglobulin": "B2M",
        "Ki-67": "KI67",
        "Granzyme B": "GZMB",
        "PD-L1": "PDL1",
        "HLA-DR": "HLA_DR",
        "TCRgd": "TCR_GD",
        "Na-K ATPase": "NAKATP"
      },
      "no_equivalent": ["CD161", "RORgT", "CD153 (CD30L)", "CD86", "CD123", "IL-10"]
    }
  }
}
